<?xml version="1.0" encoding="utf-8"?>
<!--
  Jupyroid launcher icon, foreground layer. Original artwork: a notebook cell's "[ ]" with a
  banded gas-giant planet in it. Everything sits inside the 66dp safe zone of the 108dp canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cell brackets -->
    <path
        android:pathData="M40.5,35.5H33V72.5H40.5M67.5,35.5H75V72.5H67.5"
        android:strokeWidth="4.5"
        android:strokeColor="#FFEAF1FF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Planet, clipped to its disc -->
    <group>
        <clip-path android:pathData="M39,54a15,15 0,1 0,30 0a15,15 0,1 0,-30 0z" />
        <path android:fillColor="#FFF0A35E" android:pathData="M39,39h30v30h-30z" />
        <!-- Bands: slightly wavy so it reads as a planet, not a flag -->
        <path android:fillColor="#FFFCE3C0" android:pathData="M39,42.5C46,41.6 60,43.4 69,42.4V46C60,47 46,45.2 39,46.1z" />
        <path android:fillColor="#FFD9733A" android:pathData="M39,49C47,48.2 59,50.2 69,49.2V53.2C59,54.2 47,52.2 39,53z" />
        <path android:fillColor="#FFFCE3C0" android:pathData="M39,56.4C46,55.6 60,57.4 69,56.6V59.6C60,60.4 46,58.6 39,59.4z" />
        <path android:fillColor="#FFC4622F" android:pathData="M39,62.6C47,61.9 59,63.6 69,62.8V69H39z" />
        <!-- The big storm -->
        <path android:fillColor="#FFB23A26" android:pathData="M56,55.4a3.6,2.1 0,1 0,7.2 0a3.6,2.1 0,1 0,-7.2 0z" />
        <!-- Terminator shading for some volume -->
        <path android:pathData="M39,39h30v30h-30z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="49"
                    android:centerY="48"
                    android:gradientRadius="22">
                    <item android:offset="0" android:color="#00000000" />
                    <item android:offset="0.55" android:color="#00000000" />
                    <item android:offset="1" android:color="#59000000" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
